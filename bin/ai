#!/data/data/com.termux/files/usr/bin/bash

VERSION="0.5.0"

show_help() {
cat <<HELP
AI Toolkit

Commands:
  version
  discover
  inspect [path]
  context [path]
  work [path]
HELP
}

discover() {
echo "========== PROJECT DISCOVERY =========="
echo
echo "Repository:"
git rev-parse --show-toplevel 2>/dev/null
echo
echo "Branch:"
git branch --show-current 2>/dev/null
}

inspect_repo() {
ROOT="${1:-.}"
bash "$(dirname "$0")/../lib/repository_inspector.sh" "$ROOT"
}

context_repo() {
ROOT="${1:-.}"
bash "$(dirname "$0")/../lib/context_engine.sh" "$ROOT"
}

work_repo() {
ROOT="${1:-.}"
bash "$(dirname "$0")/../lib/work_engine.sh" "$ROOT"
}

case "${1:-help}" in
    version)
        echo "$VERSION"
        ;;
    discover)
        discover
        ;;
    inspect)
        shift
        inspect_repo "$@"
        ;;
    context)
        shift
        context_repo "$@"
        ;;
    work)
        shift
        work_repo "$@"
        ;;
    *)
        show_help
        ;;
esac
