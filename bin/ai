#!/usr/bin/env python3

from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib.python.cli.engineering import engineering_audit, engineering_gap


def usage():
    print("AI Toolkit CLI")
    print()
    print("Commands:")
    print("  ai engineering audit CORE-022")
    print("  ai engineering gap CORE-022")


def main():

    args = sys.argv[1:]

    if len(args) != 3:
        usage()
        return

    if args[0] != "engineering":
        usage()
        return

    if args[1] == "audit":
        engineering_audit(args[2])
        return

    if args[1] == "gap":
        engineering_gap(args[2])
        return

    usage()


if __name__ == "__main__":
    main()
