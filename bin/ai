#!/data/data/com.termux/files/usr/bin/bash

VERSION="0.3.0"

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

show_help() {
cat <<HELP
AI Toolkit $VERSION

Usage:

  ai discover
  ai inspect
  ai context
  ai github
  ai railway
  ai telegram
  ai version
HELP
}

discover() {

echo
echo "========== PROJECT DISCOVERY =========="
echo

echo "Repository:"
git rev-parse --show-toplevel 2>/dev/null || echo "Not a git repository"

echo
echo "Branch:"
git branch --show-current 2>/dev/null

echo
echo "Remote:"
git remote -v 2>/dev/null

echo
echo "Python:"
find . -maxdepth 2 -name "*.py" | wc -l

echo
echo "Markdown:"
find . -name "*.md" | wc -l

echo
echo "Tests:"
find . -type d -name tests

echo
echo "Railway:"
find . -maxdepth 2 -name "railway.json"

echo
echo "GitHub:"
find . -maxdepth 2 -name ".github"

echo
echo "Done."
}

case "$1" in
discover)
discover
;;

version)
echo "$VERSION"
;;

*)
show_help
;;
esac

