#!/data/data/com.termux/files/usr/bin/bash

VERSION="0.5.0"

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

header() {
echo
echo "=============================================="
echo " AI TOOLKIT $VERSION"
echo "=============================================="
echo
}

context() {

[ -z "$ROOT" ] && {
    echo "Not inside a Git repository."
    exit 1
}

mkdir -p "$ROOT/.ai/context"

OUT="$ROOT/.ai/context/project-context.md"

{
echo "# AI Project Context"
echo
echo "Generated: $(date)"
echo
echo "## Repository"
basename "$ROOT"
echo
echo "## Branch"
git branch --show-current
echo
echo "## Remote"
git remote -v
echo
echo "## Last Commit"
git log -1 --oneline
echo
echo "## Git Status"
git status --short
echo
echo "## Top-level Directories"
find "$ROOT" -maxdepth 1 -type d | sort
echo
echo "## Python Files"
find "$ROOT" -name "*.py" | wc -l
echo
echo "## Markdown Files"
find "$ROOT" -name "*.md" | wc -l
echo
echo "## Test Directories"
find "$ROOT" -type d -name tests
echo
echo "## Canonical Documents"
find "$ROOT" -iname "*canon*" -o -path "*/canonical/*" 2>/dev/null
} > "$OUT"

echo
echo "Context generated:"
echo "$OUT"
}

case "${1:-help}" in

context)
header
context
;;

version)
echo "$VERSION"
;;

*)
echo
echo "AI Toolkit"
echo
echo "Commands:"
echo "  ai context"
echo "  ai version"
;;
esac
