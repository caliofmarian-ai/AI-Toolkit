#!/usr/bin/env python3

import argparse
import json
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]

LIB = ROOT / "lib"

if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

# ---------------------------------------------------------------------------
# Command handlers
# ---------------------------------------------------------------------------

def _cmd_inspect(args):
    from python.repository_engine.cli import inspect as inspect_repository
    target = args[0] if args else "."
    result = inspect_repository(target)
    print(json.dumps(result, indent=2))


def _cmd_engineering(args):
    from python.cli.engineering import (
        engineering_audit,
        engineering_gap,
        engineering_plan,
        engineering_execute,
        engineering_validate,
        engineering_build,
    )
    _sub = {
        "audit":    engineering_audit,
        "gap":      engineering_gap,
        "plan":     engineering_plan,
        "execute":  engineering_execute,
        "validate": engineering_validate,
        "build":    engineering_build,
    }
    if len(args) != 2 or args[0] not in _sub:
        print("Usage: ai engineering <audit|gap|plan|execute|validate|build> CORE-XXX")
        raise SystemExit(1)
    _sub[args[0]](args[1])


def _cmd_dashboard(args):
    parser = argparse.ArgumentParser(prog="ai dashboard")
    parser.add_argument("action", choices=["serve"])
    parser.add_argument("--host", default=os.environ.get("HOST", "0.0.0.0" if os.environ.get("PORT") else "127.0.0.1"))
    parser.add_argument("--port", type=int, default=int(os.environ.get("PORT", "8081")))
    parser.add_argument("--workspace", default=str(ROOT.parent))
    parser.add_argument("--repository", default=str(ROOT))
    parser.add_argument("--open-browser", action="store_true", dest="open_browser")
    parsed = parser.parse_args(args)

    if parsed.action == "serve":
        from python.dashboard import serve_dashboard

        serve_dashboard(
            host=parsed.host,
            port=parsed.port,
            repository_root=parsed.repository,
            workspace_root=parsed.workspace,
            open_browser=parsed.open_browser,
        )


# ---------------------------------------------------------------------------
# Registry – add new top-level commands here
# ---------------------------------------------------------------------------

_COMMANDS = {
    "dashboard":   _cmd_dashboard,
    "inspect":     _cmd_inspect,
    "engineering": _cmd_engineering,
}


def _usage():
    print("Usage:")
    print("  ai dashboard serve [--host HOST] [--port PORT] [--workspace PATH] [--repository PATH] [--open-browser]")
    print("  ai inspect [PATH]")
    print("  ai engineering <audit|gap|plan|execute|validate|build> CORE-XXX")


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main():
    args = sys.argv[1:]
    if not args or args[0] not in _COMMANDS:
        _usage()
        raise SystemExit(1)
    _COMMANDS[args[0]](args[1:])


if __name__ == "__main__":
    main()
