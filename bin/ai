#!/data/data/com.termux/files/usr/bin/bash

VERSION="0.2.0"
PROJECTS_ROOT="$HOME/storage/shared/AI-Projects"

show_help() {
cat <<HELP

AI Toolkit v$VERSION

Commands

  ai version
  ai projects
  ai project <keyword>

HELP
}

list_projects() {
find "$PROJECTS_ROOT" -mindepth 1 -maxdepth 1 -type d | sort
}

open_project() {

KEY="$1"

if [ -z "$KEY" ]; then
    echo "Usage: ai project <keyword>"
    exit 1
fi

MATCH="$(find "$PROJECTS_ROOT" -mindepth 1 -maxdepth 1 -type d | grep -i "$KEY" | head -1)"

if [ -z "$MATCH" ]; then
    echo "Project not found."
    exit 1
fi

echo
echo "Project:"
echo "$MATCH"
echo
echo "To enter:"
echo
echo "cd \"$MATCH\""

}

case "${1:-help}" in

version)
echo "AI Toolkit $VERSION"
;;

projects)
list_projects
;;

project)
shift
open_project "$1"
;;

*)
show_help
;;

esac

