#!/data/data/com.termux/files/usr/bin/bash

VERSION="1.1.0"

show_help() {
cat <<HELP
AI Toolkit

Commands:
  version
  discover
  inspect [path]
  context [path]
  work [path]
  plan [path]
  execute [path]
  review [path]
  git <command> [path]
  github <command>
  issue start <number>
HELP
}

discover() {
echo "========== PROJECT DISCOVERY =========="
echo
echo "Repository:"
git rev-parse --show-toplevel 2>/dev/null
echo
echo "Branch:"
git branch --show-current 2>/dev/null
}

inspect_repo() {
bash "$(dirname "$0")/../lib/repository_inspector.sh" "${1:-.}"
}

context_repo() {
bash "$(dirname "$0")/../lib/context_engine.sh" "${1:-.}"
}

work_repo() {
bash "$(dirname "$0")/../lib/work_engine.sh" "${1:-.}"
}

plan_repo() {
bash "$(dirname "$0")/../lib/planner_engine.sh" "${1:-.}"
}

execute_repo() {
bash "$(dirname "$0")/../lib/execution_engine.sh" "${1:-.}"
}

review_repo() {
bash "$(dirname "$0")/../lib/review_engine.sh" "${1:-.}"
}

git_repo() {
CMD="${1:-status}"
shift
bash "$(dirname "$0")/../lib/git_engine.sh" "$CMD" "${1:-.}"
}

github_repo() {
bash "$(dirname "$0")/../lib/github_engine.sh" "$@"
}

issue_repo() {
bash "$(dirname "$0")/../lib/issue_engine.sh" "$@"
}

case "${1:-help}" in
version)
    echo "$VERSION"
    ;;
discover)
    discover
    ;;
inspect)
    shift
    inspect_repo "$@"
    ;;
context)
    shift
    context_repo "$@"
    ;;
work)
    shift
    work_repo "$@"
    ;;
plan)
    shift
    plan_repo "$@"
    ;;
execute)
    shift
    execute_repo "$@"
    ;;
review)
    shift
    review_repo "$@"
    ;;
git)
    shift
    git_repo "$@"
    ;;
github)
    shift
    github_repo "$@"
    ;;
issue)
    shift
    issue_repo "$@"
    ;;
*)
    show_help
    ;;
esac
