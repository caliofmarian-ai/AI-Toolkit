#!/data/data/com.termux/files/usr/bin/bash

VERSION="0.6.0"

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

header() {
echo
echo "=============================================="
echo " AI TOOLKIT $VERSION"
echo "=============================================="
echo
}

work() {

TYPE="$1"
TARGET="$2"

if [ -z "$TYPE" ] || [ -z "$TARGET" ]; then
    echo "Usage:"
    echo "  ai work issue <number>"
    echo "  ai work pr <number>"
    echo "  ai work feature <name>"
    exit 1
fi

mkdir -p "$ROOT/.ai/work"

REPORT="$ROOT/.ai/work/session.md"

{
echo "# AI Work Session"
echo
echo "Generated: $(date)"
echo
echo "Repository:"
basename "$ROOT"
echo
echo "Branch:"
git branch --show-current
echo
echo "Type: $TYPE"
echo "Target: $TARGET"
echo
echo "Last Commit:"
git log -1 --oneline
echo
echo "Git Status:"
git status --short
echo
echo "Modified Files:"
git diff --name-only
echo
echo "Untracked:"
git ls-files --others --exclude-standard
} > "$REPORT"

echo
echo "Session created:"
echo "$REPORT"

}

case "$1" in

version)
echo "$VERSION"
;;

work)
shift
work "$@"
;;

*)
cat <<HELP

AI Toolkit

Commands

  ai work issue <id>
  ai work pr <id>
  ai work feature <name>

HELP
;;

esac
