#!/data/data/com.termux/files/usr/bin/bash

VERSION="0.4.0"

command="${1:-help}"

header() {
echo
echo "=============================================="
echo " AI TOOLKIT $VERSION"
echo "=============================================="
echo
}

discover() {

header

echo "[Repository]"
git rev-parse --show-toplevel 2>/dev/null || echo "Not a git repository"

echo
echo "[Branch]"
git branch --show-current 2>/dev/null

echo
echo "[Remote]"
git remote -v 2>/dev/null

echo
echo "[Git Status]"
git status --short 2>/dev/null

echo
echo "[Languages]"
printf "Python     : "
find . -name "*.py" | wc -l

printf "Shell      : "
find . -name "*.sh" | wc -l

printf "Markdown   : "
find . -name "*.md" | wc -l

printf "JSON       : "
find . -name "*.json" | wc -l

printf "YAML       : "
find . \( -name "*.yml" -o -name "*.yaml" \) | wc -l

echo
echo "[Directories]"
find . -maxdepth 2 -type d | sort

echo
echo "[Tests]"
find . -type d -name tests

echo
echo "[Integrations]"

[ -d ".github" ] && echo "GitHub      : YES" || echo "GitHub      : NO"

find . -name railway.json | grep . >/dev/null \
&& echo "Railway     : YES" \
|| echo "Railway     : NO"

find . -name Dockerfile | grep . >/dev/null \
&& echo "Docker      : YES" \
|| echo "Docker      : NO"

echo
echo "[Done]"
}

doctor() {

header

echo "[Git]"
git --version

echo
echo "[GitHub CLI]"
gh --version | head -1

echo
echo "[Python]"
python --version 2>/dev/null || python3 --version

echo
echo "[Termux API]"
command -v termux-battery-status >/dev/null \
&& echo "Installed" \
|| echo "Missing"

echo
echo "[Network]"
ping -c1 github.com >/dev/null 2>&1 \
&& echo "Online" \
|| echo "Offline"

echo
echo "[Disk]"
df -h .

echo
echo "[Done]"
}

case "$command" in

version)
echo "$VERSION"
;;

discover|inspect)
discover
;;

doctor)
doctor
;;

*)
cat <<HELP

AI Toolkit

Commands

  ai discover
  ai inspect
  ai doctor
  ai version

HELP
;;

esac
